# Copy to .env (gitignored) for the local lane, or set in the host's encrypted env.
CM_SECRET=            # session signing key; local lane generates data/.secret when unset
CM_ADMIN_PIN=         # admin PIN, required (6+ characters)
CM_USER_PIN=          # user PIN, required (6+ characters, different from admin)
CM_CLOUD=             # 1 on the hosted demo: corrections are not stored
CM_MAX_UPLOAD=        # bytes; hosted demo default 4400000 (host caps a request at 4.5 MB)
